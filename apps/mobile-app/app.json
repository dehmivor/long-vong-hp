{
  "expo": {
    "name": "Long Vong HP",
    "slug": "long-vong-hp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "longvonghp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.longvonghp.app"
    },
    "android": {
      "package": "vn.longvonghp.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0F1E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0F1E",
          "dark": {
            "backgroundColor": "#0A0F1E"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Long Vong HP dung vi tri cua ban de tim quan an gan day va check-in trong ban kinh 50m."
        }
      ],
      "expo-video",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Long Vong HP dung camera de quet ma QR check-in tai quan.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "ownerEmail": "minhtamnghp03@gmail.com",
      "projectName": "Long Vong HP"
    }
  }
}
