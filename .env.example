# Shared public Supabase settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Expo uses EXPO_PUBLIC_* variables
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Android map tiles need a Google Maps API key (iOS uses Apple Maps by default).
# Add it under android.config.googleMaps.apiKey in app.json before an Android build.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Owner/contact metadata for deployment notes and store accounts
LONG_VONG_HP_OWNER_EMAIL=minhtamnghp03@gmail.com
